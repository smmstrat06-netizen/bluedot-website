# Public site URL — used for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://www.your-bluedot-domain.com

# Form endpoint that accepts a JSON POST (e.g. Formspree, Basin, or your own API).
# Leave empty during development: submissions are simulated locally.
PUBLIC_FORM_ENDPOINT=

# Public contact email shown as a fallback next to the contact form.
PUBLIC_CONTACT_EMAIL=
