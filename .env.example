# Public site URL — used for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://bluedot-mktg.com

# Make webhook that receives contact form enquiries, e.g. https://hook.eu1.make.com/xxxxxxxx
# Server-only: the form posts to /api/contact/, which forwards to this URL, so it never
# reaches the browser. On Vercel, add it under Settings → Environment Variables.
# Leave empty during development: enquiries are logged in the terminal instead.
FORM_WEBHOOK_URL=

# Public contact email shown as a fallback next to the contact form.
PUBLIC_CONTACT_EMAIL=

# Google Search Console HTML-tag verification: paste only the content value
# of <meta name="google-site-verification" content="...">.
PUBLIC_GOOGLE_SITE_VERIFICATION=
