---
import BaseLayout from "../layouts/BaseLayout.astro";
import DivisionHero from "../components/DivisionHero.astro";
import Positioning from "../components/Positioning.astro";
import ServicesSection from "../components/ServicesSection.astro";
import SectionLabel from "../components/SectionLabel.astro";
import SurfaceDiagram from "../components/SurfaceDiagram.astro";
import CrossLinks from "../components/CrossLinks.astro";
import CtaBand from "../components/CtaBand.astro";
import { getDivision } from "../data/divisions";
import { divisionSchema } from "../lib/schema";

// No Consulting page existed in the source material; copy is built from
// BlueDot's home page (Consulting summary, expertise list, point of view).
const d = getDivision("consulting");
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  image="/og/consulting.png"
  accent={d.accent}
  schema={divisionSchema(d, Astro.site!)}
>
  <DivisionHero division={d} lead={d.summary} />

  <Positioning
    num="01"
    title="Strategy shouldn’t stay on paper."
    text="BlueDot Consulting works from inside your business — alongside your leadership and teams — to set a clear marketing direction and make sure it turns into action."
    fit={[
      "You need senior marketing leadership, without a full-time hire.",
      "There’s plenty of marketing activity, but no clear direction.",
      "Your positioning or offer needs sharpening before you invest more.",
    ]}
  />

  <ServicesSection
    num="02"
    title="From direction to leadership."
    lead="Open a service to see the problem it solves, what we do and what you get."
    services={d.services}
    group="consulting-services"
  />

  <section id="below-the-surface" class="section section--rule" aria-labelledby="surface-title">
    <div class="container">
      <div class="split">
        <SectionLabel num="03" text="Point of view" />
        <div>
          <h2 id="surface-title" class="h2" data-reveal>Your marketing problem might not be a marketing problem.</h2>
          <p class="lead page__lead" data-reveal style="--i: 1">
            Too few leads, campaigns that don’t land, budget with little return — these are often symptoms. The cause
            can sit below the surface, so that’s where we look first.
          </p>
        </div>
      </div>
      <div class="offset page__visual">
        <SurfaceDiagram />
      </div>
    </div>
  </section>

  <CrossLinks
    num="04"
    current="consulting"
    title="Direction, connected to execution."
    text="When the direction is set, BlueDot Agency brings it to life and BlueDot Media amplifies it — without losing the thinking along the way."
  />

  <CtaBand
    title="Let’s find the real problem first."
    text="Tell us where you are. We’ll look at what’s underneath — and what to do next."
    cta={d.cta}
    href="/contact/?interest=consulting"
    accent={d.accent}
  />
</BaseLayout>

<style>
  .page__lead {
    margin-top: var(--space-m);
  }

  .page__visual {
    margin-top: var(--space-2xl);
  }
</style>
