---
import BaseLayout from "../layouts/BaseLayout.astro";
import DivisionHero from "../components/DivisionHero.astro";
import Positioning from "../components/Positioning.astro";
import ServicesSection from "../components/ServicesSection.astro";
import SectionLabel from "../components/SectionLabel.astro";
import BudgetSignals from "../components/visuals/BudgetSignals.astro";
import MetricsDashboard from "../components/visuals/MetricsDashboard.astro";
import CrossLinks from "../components/CrossLinks.astro";
import CtaBand from "../components/CtaBand.astro";
import { getDivision } from "../data/divisions";
import { divisionSchema } from "../lib/schema";

const d = getDivision("media");
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  image="/og/media.png"
  accent={d.accent}
  schema={divisionSchema(d, Astro.site!)}
>
  <DivisionHero division={d} lead="Media strategy and performance built around business impact — not vanity metrics." />

  <Positioning
    num="01"
    title="Buying media is easy. Knowing where to invest is the work."
    text="We plan, buy and optimize media across channels with one objective: making investment work harder."
    fit={[
      "You’re spending on media, but can’t see its effect on the business.",
      "Channels are managed separately, each optimizing for its own numbers.",
      "You need to decide where to scale, shift or stop spend.",
    ]}
  />

  <ServicesSection
    num="02"
    title="From plan to proof."
    lead="Open a service to see the problem it solves, what we do and what you get."
    services={d.services}
    group="media-services"
  />

  <section class="section section--rule" aria-labelledby="spend-title">
    <div class="container">
      <div class="split">
        <SectionLabel num="03" text="Point of view" />
        <div>
          <h2 id="spend-title" class="h2" data-reveal>The smartest media decision is sometimes where not to spend.</h2>
          <p class="lead page__lead" data-reveal style="--i: 1">
            Performance is not about exhausting the budget. It’s about knowing when to scale, where to move investment
            and when to stop.
          </p>
        </div>
      </div>
      <div class="offset page__visual">
        <BudgetSignals />
      </div>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="metrics-title">
    <div class="container">
      <div class="split">
        <SectionLabel num="04" text="What really matters" />
        <div>
          <h2 id="metrics-title" class="h2" data-reveal>Great media metrics can hide bad business.</h2>
          <p class="lead page__lead" data-reveal style="--i: 1">
            A low cost per lead, rising click-through, falling cost per click — and no sales. We connect media metrics to
            real business outcomes, so the numbers that look good are also the numbers that matter.
          </p>
        </div>
      </div>
      <div class="page__visual">
        <MetricsDashboard />
      </div>
    </div>
  </section>

  <CrossLinks
    num="05"
    current="media"
    title="Media works harder with the right thinking and the right work."
    text="BlueDot Consulting sets the direction media should serve. BlueDot Agency creates the work media amplifies."
  />

  <CtaBand
    title="Make every investment work harder."
    text="Tell us what you’re spending and what it needs to achieve."
    cta={d.cta}
    href="/contact/?interest=media"
    accent={d.accent}
  />
</BaseLayout>

<style>
  .page__lead {
    margin-top: var(--space-m);
  }

  .page__visual {
    margin-top: var(--space-2xl);
  }
</style>
