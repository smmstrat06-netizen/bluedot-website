---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import Belief from "../components/home/Belief.astro";
import Divisions from "../components/home/Divisions.astro";
import SituationPicker from "../components/home/SituationPicker.astro";
import HowWeWork from "../components/home/HowWeWork.astro";
import SectionLabel from "../components/SectionLabel.astro";
import SurfaceDiagram from "../components/SurfaceDiagram.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import { faqs } from "../data/home";
import { faqSchema, organizationSchema, websiteSchema } from "../lib/schema";

const base = Astro.site!;
---

<BaseLayout
  title="BlueDot — Marketing Strategy, Creative & Media Under One Roof"
  description="BlueDot connects marketing strategy, creative and media under one roof — consulting, fractional CMO, brand, content and media built around business impact."
  schema={[organizationSchema(base), websiteSchema(base), faqSchema(faqs)]}
>
  <HomeHero />
  <Belief />
  <Divisions />
  <SituationPicker />
  <HowWeWork />

  <section class="section section--rule pov-section" aria-labelledby="pov-title">
    <div class="container split">
      <SectionLabel num="05" text="Point of view" />
      <div class="pov">
        <div>
          <h2 id="pov-title" class="h2" data-reveal>Your marketing problem might not be a marketing problem.</h2>
          <p class="lead pov__lead" data-reveal style="--i: 1">
            Too few leads, campaigns that don’t land, budget with little return — these are often symptoms. The cause
            can sit below the surface. That’s where we look first.
          </p>
          <a href="/consulting/#below-the-surface" class="link pov__link" data-reveal style="--i: 2">
            See what we look at
            <Icon name="arrow-right" class="link__icon link__icon--right" />
          </a>
        </div>
        <SurfaceDiagram compact />
      </div>
    </div>
  </section>

  <FAQ num="06" items={faqs} />
  <ContactSection num="07" />
</BaseLayout>

<style>
  .pov-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 800px 500px at 80% 50%, rgba(7, 122, 231, 0.07), transparent 70%),
      radial-gradient(ellipse 500px 400px at 20% 30%, rgba(186, 109, 255, 0.03), transparent 60%);
  }

  .pov-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(7, 122, 231, 0.25) 20%, rgba(255, 255, 255, 0.12) 50%, rgba(234, 109, 32, 0.2) 80%, transparent);
    pointer-events: none;
  }

  .pov {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .pov {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  .pov__lead {
    margin-top: var(--space-m);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
  }

  .pov__link {
    margin-top: var(--space-l);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }

  .pov__link :global(.link__icon) {
    transition: transform 0.25s var(--ease-out);
  }

  .pov__link:hover :global(.link__icon) {
    transform: translateX(4px);
  }

  .pov :global(.surface) {
    border-color: rgba(7, 122, 231, 0.25);
    box-shadow:
      0 24px 48px -18px rgba(0, 0, 0, 0.7),
      0 0 35px -10px rgba(7, 122, 231, 0.2);
  }
</style>
