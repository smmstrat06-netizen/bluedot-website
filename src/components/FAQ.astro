---
import SectionLabel from "./SectionLabel.astro";
import Icon from "./Icon.astro";

interface Props {
  num: string;
  items: { q: string; a: string }[];
  title?: string;
}

const { num, items, title = "Good to know before we talk." } = Astro.props;
---

<section class="section section--rule faq" aria-labelledby="faq-title">
  <div class="container split">
    <SectionLabel num={num} text="Questions" />
    <div class="faq__grid">
      <h2 id="faq-title" class="h2" data-reveal>{title}</h2>
      <div class="faq__list" data-reveal style="--i: 1">
        {
          items.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">
                <span>{item.q}</span>
                <span class="faq__icon" aria-hidden="true">
                  <Icon name="plus" />
                </span>
              </summary>
              <div class="faq__a">
                <p class="body">{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 75rem) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    position: relative;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.3s var(--ease-out);
  }

  /* Left accent line indicator when open */
  .faq__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--blue);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.35s var(--ease-out);
  }

  .faq__item[open]::before {
    transform: scaleY(1);
  }

  .faq__item[open] {
    background: linear-gradient(90deg, rgba(7, 122, 231, 0.05) 0%, transparent 65%);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.75rem;
    padding: 1.2rem 0.75rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: #ffffff;
    font-size: var(--step-1);
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
    transition: color 0.25s var(--ease-out);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .faq__icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .faq__q:hover .faq__icon {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.08);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--blue);
    border-color: var(--blue);
    color: #ffffff;
    box-shadow: 0 0 14px rgba(7, 122, 231, 0.45);
  }

  .faq__a {
    padding: 0 3.5rem 1.6rem 0.75rem;
  }

  .faq__a p {
    line-height: 1.65;
    color: var(--fg-2);
  }

  .faq__item::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.5s var(--ease-out),
      content-visibility 0.5s allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
    block-size: calc-size(auto, size);
  }
</style>
