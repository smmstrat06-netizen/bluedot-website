---
import Logo from "./Logo.astro";
import { site, mapsUrl } from "../config/site";
import { getDivisions } from "../data/divisions";
import { getLang, href } from "../i18n";
import { ui } from "../i18n/ui";
import Icon from "./Icon.astro";

const lang = getLang(Astro.url);
const t = ui[lang];
const divisions = getDivisions(lang);
const home = href("home", lang);
const contact = href("contact", lang);

const year = new Date().getFullYear();
const socials = site.social.filter((s) => s.href);
const words = [
  { text: "Think", dot: "var(--think)" },
  { text: "Create", dot: "var(--create)" },
  { text: "Amplify", dot: "var(--amplify)" },
];
const expertise = [
  { label: lang === "fr" ? "Création de site web" : "Website design", href: href("website", lang) },
  { label: lang === "fr" ? "Événementiel" : "Events", href: href("events", lang) },
  { label: t.footer.how, href: `${home}#how` },
  { label: t.footer.start, href: `${home}#start` },
];
---

<footer class="footer" data-hide-mcta>
  <div class="container">
    <div class="footer__top">
      <p class="footer__tagline">
        {
          words.map((w) => (
            <Fragment>
              <span class="footer__word">
                {w.text}
                <span class="dot" style={`--dot: ${w.dot}`}>
                  <span class="sr-only">.</span>
                </span>
              </span>{" "}
            </Fragment>
          ))
        }
      </p>
      <a href={contact} class="btn btn--primary">
        {t.footer.cta}
      </a>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <a href={home} class="brand" aria-label={t.brandHome}>
          <Logo />
        </a>
        <p class="small muted">{t.footer.about}</p>
      </div>

      <nav class="footer__col" aria-label={t.footer.divisions}>
        <p class="mono footer__heading">{t.footer.divisions}</p>
        <ul role="list">
          {
            divisions.map((d) => (
              <li>
                <a href={d.href} class="footer__link" style={`--accent: ${d.accent}`}>
                  <span class="footer__dot" aria-hidden="true" />
                  {d.name}
                  <span class="muted">— {d.verb}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer__col" aria-label={t.footer.company}>
        <p class="mono footer__heading">{t.footer.company}</p>
        <ul role="list">
          {
            expertise.map((item) => (
              <li>
                <a href={item.href} class="footer__link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__col">
        <p class="mono footer__heading">{t.footer.touch}</p>
        <ul role="list">
          <li>
            <a href={mapsUrl} class="footer__link footer__address" target="_blank" rel="noopener">
              <address>
                {site.address.street}<br />
                {site.address.city} {site.address.postalCode}, {t.contact.country}
              </address>
              <span class="sr-only">{t.footer.mapsSr}</span>
            </a>
          </li>
          {
            site.email && (
              <li>
                <a href={`mailto:${site.email}`} class="footer__link">
                  {site.email}
                </a>
              </li>
            )
          }
          {
            socials.map((s) => (
              <li>
                <a href={s.href} class="footer__link" target="_blank" rel="noopener">
                  {s.label}
                  <Icon name="arrow-up-right" class="footer__ext" />
                </a>
              </li>
            ))
          }
          <li><a href={contact} class="footer__link">{t.footer.message}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="small muted">© {year} BlueDot. {t.footer.rights}</p>
      <a href="#main" class="small footer__link footer__totop">{t.footer.top}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid var(--line);
    padding-top: var(--section);
    overflow: hidden;
  }

  .footer::before {
    content: "";
    position: absolute;
    inset: auto -20% -60% -20%;
    height: 90%;
    pointer-events: none;
  }

  .footer__top {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
    padding-bottom: var(--space-2xl);
  }

  .footer__tagline {
    font-family: var(--font-display);
    font-weight: 700;
    color: #ffffff;
    font-size: var(--step-5);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .footer__word {
    white-space: nowrap;
  }

  .footer__grid {
    position: relative;
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 40rem) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }
  }

  .footer__brand {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    max-width: 22rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
  }


  .footer__heading {
    color: var(--fg-3);
    margin-bottom: var(--space-s);
  }

  .footer__col ul {
    display: grid;
    gap: 0.15rem;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    color: var(--fg-2);
    transition: color var(--dur) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--fg);
  }

  .footer__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .footer__link :global(.footer__ext) {
    width: 0.9em;
    height: 0.9em;
  }

  .footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m) calc(var(--space-l) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }

  @media (max-width: 47.99rem) {
    .footer__bottom {
      padding-bottom: calc(6rem + env(safe-area-inset-bottom));
    }
  }

  .footer__address {
    align-items: flex-start;
    padding-block: 0.35rem;
    line-height: 1.5;
  }

  .footer__address address {
    font-style: normal;
  }
</style>
