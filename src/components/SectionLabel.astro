---
interface Props {
  num?: string;
  text: string;
  accent?: string;
  class?: string;
}

const { num, text, accent, class: className } = Astro.props;
---

<p class:list={["label", className]} style={accent ? `--accent: ${accent}` : undefined}>
  {num && <span class="label__num">{num}</span>}
  <span>{text}</span>
</p>
