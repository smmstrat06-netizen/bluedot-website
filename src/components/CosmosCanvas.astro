---
interface Props {
  scene: "system" | "think" | "create" | "amplify";
  /** Horizontal position of the dot, 0–1 */
  cx?: number;
  /** Vertical position of the dot, 0–1 */
  cy?: number;
  /** System radius relative to the shorter side */
  scale?: number;
}

const { scene, cx = 0.7, cy = 0.48, scale = 0.44 } = Astro.props;
---

<div class="cosmos" aria-hidden="true" style={`--cx: ${cx * 100}%; --cy: ${cy * 100}%`}>
  <canvas data-cosmos data-scene={scene} data-cx={cx} data-cy={cy} data-scale={scale}></canvas>
</div>

<script>
  import { mountCosmos } from "../scripts/cosmos";

  // Start once the page has loaded and the main thread is idle, so the scene
  // never competes with first render. The CSS glow stands in until then.
  const mountAll = () => document.querySelectorAll<HTMLCanvasElement>("canvas[data-cosmos]").forEach(mountCosmos);
  const whenIdle = () =>
    "requestIdleCallback" in window ? requestIdleCallback(mountAll, { timeout: 2000 }) : setTimeout(mountAll, 400);

  if (document.readyState === "complete") whenIdle();
  else window.addEventListener("load", whenIdle, { once: true });
</script>

<style>
  .cosmos {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Static fallback while the canvas boots, or without JavaScript */
    background:
      radial-gradient(circle at var(--cx) var(--cy), rgb(59 123 255 / 0.5) 0, rgb(59 123 255 / 0.12) 4rem, transparent 22rem),
      radial-gradient(circle at var(--cx) var(--cy), color-mix(in oklab, var(--accent) 16%, transparent) 0, transparent 38rem);
  }

  @media (max-width: 47.49rem) {
    .cosmos {
      --cx: 62% !important;
      --cy: 30% !important;
    }
  }

  canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.8s var(--ease-out);
  }

  canvas:global(.is-live) {
    opacity: 1;
  }
</style>
