---
import { site } from "../config/site";
import { alternates, defaultLang, getLang, htmlLang, langs, ogLocale } from "../i18n";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title, description, image = "/og/home.png", noindex = false, schema = [] } = Astro.props;

const lang = getLang(Astro.url);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Equivalent page in each language (none on the 404 page)
const alt = noindex ? undefined : alternates(Astro.url);
// Google Search Console ownership tag, set in .env or the hosting dashboard
const gscToken = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{gscToken && <meta name="google-site-verification" content={gscToken} />}

{
  alt && (
    <Fragment>
      {langs.map((l) => (
        <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alt[l], Astro.site)} />
      ))}
      <link rel="alternate" hreflang="x-default" href={new URL(alt[defaultLang], Astro.site)} />
    </Fragment>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={ogLocale[lang]} />
{langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
