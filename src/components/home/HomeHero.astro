---
import Icon from "../Icon.astro";
import { divisions } from "../../data/divisions";

const words = [
  { text: "Think", dot: "var(--think)" },
  { text: "Create", dot: "var(--create)" },
  { text: "Amplify", dot: "var(--amplify)" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Cosmic background — photographic planetary imagery from brand kit -->
  <div class="hero__bg" aria-hidden="true">
    <img
      src="/brand-assets/hero-cosmic.jpg"
      alt=""
      class="hero__bg-img"
      width="1400"
      height="787"
      loading="eager"
      decoding="async"
    />
    <!-- Luminous gradient overlay: ensures 100% legibility on left while preserving cosmic vibrancy on right -->
    <div class="hero__overlay"></div>
  </div>

  <!-- Atmospheric glows matching brand kit colors -->
  <div class="hero__glows" aria-hidden="true">
    <div class="hero__glow hero__glow--blue"></div>
    <div class="hero__glow hero__glow--violet"></div>
  </div>

  <!-- Main Hero Stage: Perfectly balanced above the fold -->
  <div class="container hero__stage">
    <div class="hero__content">
      <p class="label hero__eyebrow">
        <span class="label__dot" aria-hidden="true"></span>
        Marketing strategy · Creative · Media
      </p>

      <h1 id="hero-title" class="hero__title">
        {
          words.map((w, i) => (
            <Fragment>
              <span class="hero__word" style={`--dot: ${w.dot}; --d: ${i}`}>
                {w.text}
                <span class="dot" style={`--dot: ${w.dot}`}>
                  <span class="sr-only">.</span>
                </span>
              </span>{" "}
            </Fragment>
          ))
        }
      </h1>

      <p class="lead hero__lead">
        BlueDot brings marketing strategy, creative execution and media performance together under one roof — so every part
        of your marketing works toward the same business result.
      </p>

      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary hero__btn-primary">
          <span class="btn__dot" aria-hidden="true"></span>
          Let's talk
        </a>
        <a href="#start" class="btn btn--ghost hero__btn-ghost">
          Find your starting point
          <Icon name="arrow-down" class="btn__icon btn__icon--down" />
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Division Dock: Elevated frosted glass ticker bridging hero to content -->
  <nav class="container hero__index" aria-label="Explore our divisions">
    <ul role="list" class="hindex">
      {
        divisions.map((d) => (
          <li class="hindex__cell">
            <a href={d.href} class="hindex__item" style={`--accent: ${d.accent}`}>
              <span class="hindex__meta mono">
                <span class="label__dot" aria-hidden="true" />
                <span class="hindex__num">{d.index} —</span>
                {d.verb}
              </span>
              <span class="hindex__name">{d.name}</span>
              <span class="hindex__desc">{d.tagline}</span>
              <Icon name="arrow-up-right" class="hindex__icon" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100svh;
    padding-top: var(--header-h);
    overflow: hidden;
    background: var(--void);
  }

  /* ── Photographic cosmic background ── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right 38%;
    opacity: 0.85;
    transition: opacity 0.8s ease;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      /* Left fade: gives pristine readability to typography and CTAs */
      linear-gradient(90deg,
        rgb(0 0 0 / 0.98) 0%,
        rgb(0 0 0 / 0.92) 32%,
        rgb(0 0 0 / 0.68) 52%,
        rgb(0 0 0 / 0.25) 72%,
        rgb(0 0 0 / 0.05) 100%
      ),
      /* Bottom fade: smooth transition into the division index bar */
      linear-gradient(0deg,
        rgb(0 0 0 / 0.95) 0%,
        rgb(0 0 0 / 0.6) 12%,
        rgb(0 0 0 / 0) 25%
      ),
      /* Top fade: ensure clean header contrast */
      linear-gradient(180deg,
        rgb(0 0 0 / 0.7) 0%,
        rgb(0 0 0 / 0) 14%
      );
  }

  @media (max-width: 47.99rem) {
    .hero__bg-img {
      object-position: 72% top;
      opacity: 0.35;
    }

    .hero__overlay {
      background: linear-gradient(180deg,
        rgb(0 0 0 / 0.8) 0%,
        rgb(0 0 0 / 0.92) 40%,
        rgb(0 0 0 / 0.98) 100%
      );
    }
  }

  /* ── Atmospheric glow accents ── */
  .hero__glows {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    pointer-events: none;
  }

  .hero__glow--blue {
    width: 50rem;
    height: 50rem;
    top: 15%;
    right: -10rem;
    background: radial-gradient(circle, rgb(7 122 231 / 0.28) 0%, transparent 65%);
    animation: hero-float-blue 10s ease-in-out infinite alternate;
  }

  .hero__glow--violet {
    width: 35rem;
    height: 35rem;
    bottom: 5%;
    left: -8rem;
    background: radial-gradient(circle, rgb(186 109 255 / 0.14) 0%, transparent 65%);
    animation: hero-float-violet 14s ease-in-out infinite alternate;
  }

  @keyframes hero-float-blue {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-30px, 40px) scale(1.08); }
  }

  @keyframes hero-float-violet {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(40px, -20px) scale(1.12); }
  }

  /* ── Stage & Content ── */
  .hero__stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(1.5rem, 1rem + 3vh, 3.5rem);
    width: 100%;
  }

  .hero__content {
    max-width: 50rem;
    z-index: 2;
  }

  .hero__eyebrow {
    animation: fade 1s var(--ease-out) both;
    margin-bottom: clamp(0.75rem, 0.5rem + 0.5vw, 1.25rem);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2.2rem + 3.8vw, 5.5rem);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.04em;
    color: #fff;
    margin-top: 0;
    text-wrap: balance;
  }

  .hero__word {
    display: inline-block;
    white-space: nowrap;
    animation: rise 1s var(--ease-out) both;
    animation-delay: calc(var(--d) * 110ms + 100ms);
  }

  .hero__lead {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
    max-width: 48ch;
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    text-wrap: pretty;
    animation: rise 1s var(--ease-out) 0.4s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(1.25rem, 1rem + 1.2vw, 2.25rem);
    animation: rise 1s var(--ease-out) 0.52s both;
  }

  .hero__btn-primary {
    font-size: 0.9375rem;
  }

  .hero__btn-ghost {
    font-size: 0.9375rem;
  }

  /* ── Division index dock — architectural mission-control bridge ── */
  .hero__index {
    position: relative;
    z-index: 3;
    animation: fade 1.2s var(--ease-out) 0.7s both;
  }

  .hindex {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-m) var(--radius-m) 0 0;
    background: linear-gradient(180deg, rgba(8, 12, 24, 0.75) 0%, rgba(5, 7, 16, 0.92) 100%);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 -8px 24px -12px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .hindex__cell + .hindex__cell {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hindex__item {
    position: relative;
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1.15rem 2.5rem 1.3rem 1.35rem;
    transition: background-color var(--dur) var(--ease-out);
  }

  .hindex__item:hover {
    background: rgba(255, 255, 255, 0.035);
  }

  .hindex__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }

  .hindex__num {
    color: var(--accent);
    font-weight: 600;
  }

  .hindex__name {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: #ffffff;
  }

  .hindex__desc {
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hindex__item :global(.hindex__icon) {
    position: absolute;
    top: 1.15rem;
    right: 1.25rem;
    width: 1rem;
    height: 1rem;
    color: var(--fg-3);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .hindex__item:hover :global(.hindex__icon) {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  /* Precision accent line on hover */
  .hindex__item::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .hindex__item:hover::after {
    transform: scaleX(1);
  }

  @media (max-width: 47.99rem) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--header-h) + 1.25rem);
      padding-bottom: 0;
      overflow-x: hidden;
    }

    .hero__stage {
      padding-block: 1.5rem 2rem;
    }

    .hero__title {
      font-size: clamp(2rem, 8.5vw, 2.75rem);
      line-height: 0.98;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .hero__word {
      white-space: normal;
    }

    .hero__lead {
      font-size: 0.9375rem;
      margin-top: 1rem;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .hero__actions {
      margin-top: 1.5rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .hero__actions .btn {
      justify-content: center;
      width: 100%;
    }

    .hindex {
      border-radius: 0;
      border-inline: 0;
    }

    .hindex__item {
      padding: 0.85rem 0.5rem 0.95rem;
      text-align: center;
      gap: 0.2rem;
      justify-items: center;
    }

    .hindex__meta {
      justify-content: center;
      gap: 0.35rem;
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
    }

    .hindex__num {
      display: inline;
    }

    .hindex__name {
      font-size: clamp(0.75rem, 3.5vw, 0.9375rem);
      line-height: 1.2;
    }

    .hindex__desc,
    .hindex__item :global(.hindex__icon) {
      display: none;
    }
  }
</style>
