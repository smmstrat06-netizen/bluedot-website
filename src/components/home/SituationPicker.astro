---
import SectionLabel from "../SectionLabel.astro";
import Icon from "../Icon.astro";
import { getHomeData } from "../../data/home";
import { getLang, href } from "../../i18n";
import { ui } from "../../i18n/ui";

const lang = getLang(Astro.url);
const { situations } = getHomeData(lang);

const copy = {
  en: {
    title: "Which sounds most like you?",
    lead: "Pick the situation closest to yours and see where we would begin.",
    legend: "Choose the situation that sounds most like yours",
    kicker: "Where we’d start",
    talk: "Talk to us about this",
  },
  fr: {
    title: "Laquelle vous ressemble le plus ?",
    lead: "Choisissez la situation la plus proche de la vôtre et voyez par où nous commencerions.",
    legend: "Choisissez la situation qui vous ressemble le plus",
    kicker: "Par où nous commencerions",
    talk: "En parler avec nous",
  },
}[lang];
---

<section id="start" class="section section--rule start" aria-labelledby="start-title">
  <div class="container">
    <div class="split">
      <SectionLabel num="03" text={ui[lang].footer.start} />
      <div>
        <h2 id="start-title" class="h2" data-reveal>{copy.title}</h2>
        <p class="lead start__lead" data-reveal style="--i: 1">{copy.lead}</p>
      </div>
    </div>

    <fieldset class="picker" data-reveal>
      <legend class="sr-only">{copy.legend}</legend>
      <div class="picker__grid">
        {
          situations.map((s, i) => (
            <Fragment>
              <label class="picker__option" style={`--accent: ${s.accent}; --row: ${i + 1}`}>
                <input class="picker__input" type="radio" name="situation" value={s.id} checked={i === 0} />
                <span class="picker__num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="picker__quote">{s.quote}</span>
                <span class="picker__radio" aria-hidden="true" />
              </label>

              <div class="picker__result" data-for={s.id} style={`--accent: ${s.accent}`}>
                <p class="mono picker__kicker">{copy.kicker}</p>
                <p class="picker__division">
                  {s.start}<span class="dot" style={`--dot: ${s.accent}`} />
                </p>
                <p class="body picker__answer">{s.answer}</p>
                <div class="picker__actions">
                  <a href={href("contact", lang, `?interest=${s.interest}`)} class="btn btn--primary">
                    {copy.talk}
                  </a>
                  <a href={s.link.href} class="link">
                    {s.link.label}
                    <Icon name="arrow-right" class="link__icon link__icon--right" />
                  </a>
                </div>
              </div>
            </Fragment>
          ))
        }
      </div>
    </fieldset>
  </div>
</section>

<style>
  .start {
    position: relative;
    overflow: hidden;
  }

  .start::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    pointer-events: none;
  }

  .start__lead {
    margin-top: var(--space-m);
  }

  .picker {
    min-width: 0;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    border: 0;
  }

  .picker__grid {
    display: grid;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 62rem) {
    .picker__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-2xl);
    }

    .picker__option {
      grid-column: 1;
      grid-row: var(--row);
    }

    .picker__result {
      grid-column: 2;
      grid-row: 1 / span 5;
      align-self: start;
    }
  }

  .picker__option {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: 0.85rem;
    align-items: center;
    padding: 1.35rem 1.15rem;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out);
  }

  .picker__option::before {
    content: "";
    position: absolute;
    left: 0;
    top: 15%;
    bottom: 15%;
    width: 2.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease-out);
  }

  .picker__option:hover {
    background: rgba(255, 255, 255, 0.035);
    transform: translateX(4px);
  }

  .picker__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .picker__num {
    padding-left: 0.25rem;
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: var(--fg-3);
    transition: color 0.25s var(--ease-out);
  }

  .picker__quote {
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--fg-2);
    transition: color 0.25s var(--ease-out);
  }

  /* Precision reticle indicator */
  .picker__radio {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.02);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .picker__radio::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .picker__option:has(:checked) {
    background: rgb(255 255 255 / 0.03);
  }

  .picker__option:has(:checked)::before {
    transform: scaleY(1);
  }

  .picker__option:has(:checked) .picker__num {
    color: var(--accent);
    font-weight: 600;
  }

  .picker__option:has(:checked) .picker__quote {
    color: #ffffff;
    font-weight: 500;
  }

  .picker__option:has(:checked) .picker__radio {
    border-color: var(--accent);
    background: color-mix(in oklab, var(--accent) 15%, transparent);
  }

  .picker__option:has(:checked) .picker__radio::after {
    transform: scale(1);
  }

  .picker__option:has(:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: -2px;
  }

  .picker__result {
    display: none;
    padding: var(--space-m) 0 var(--space-l) 3.25rem;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 61.99rem) {
    .picker__result {
      margin-top: 1rem;
      margin-bottom: 1.5rem;
      padding: 1.75rem;
      border: 1px solid var(--line-strong);
      border-top: 2px solid var(--accent);
      border-radius: 0;
      background: var(--bg-raise);
    }
  }

  @media (min-width: 62rem) {
    .picker__result {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      margin-top: var(--space-l);
      padding: clamp(1.75rem, 1.25rem + 1.8vw, 2.75rem);
      border: 1px solid var(--line-strong);
      border-top: 2px solid var(--accent);
      border-radius: 0;
      background: var(--bg-raise);
    }
  }

  .picker__grid:has(input[value="leadership"]:checked) .picker__result[data-for="leadership"],
  .picker__grid:has(input[value="underneath"]:checked) .picker__result[data-for="underneath"],
  .picker__grid:has(input[value="execution"]:checked) .picker__result[data-for="execution"],
  .picker__grid:has(input[value="media"]:checked) .picker__result[data-for="media"],
  .picker__grid:has(input[value="connected"]:checked) .picker__result[data-for="connected"] {
    display: block;
    animation: rise 0.5s var(--ease-out) both;
  }

  @supports not selector(:has(*)) {
    .picker__result {
      display: block;
    }
  }

  .picker__kicker {
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .picker__division {
    font-family: var(--font-display);
    font-weight: 700;
    color: #ffffff;
    margin-top: var(--space-s);
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .picker__answer {
    margin-top: var(--space-m);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
  }

  .picker__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.5rem;
    margin-top: var(--space-l);
  }
</style>
