---
import SectionLabel from "../SectionLabel.astro";
import Icon from "../Icon.astro";
import { situations } from "../../data/home";
---

<section id="start" class="section section--rule start" aria-labelledby="start-title">
  <div class="container">
    <div class="split">
      <SectionLabel num="03" text="Where to start" />
      <div>
        <h2 id="start-title" class="h2" data-reveal>Which sounds most like you?</h2>
        <p class="lead start__lead" data-reveal style="--i: 1">
          Pick the situation closest to yours and see where we would begin.
        </p>
      </div>
    </div>

    <fieldset class="picker" data-reveal>
      <legend class="sr-only">Choose the situation that sounds most like yours</legend>
      <div class="picker__grid">
        {
          situations.map((s, i) => (
            <Fragment>
              <label class="picker__option" style={`--accent: ${s.accent}; --row: ${i + 1}`}>
                <input class="picker__input" type="radio" name="situation" value={s.id} checked={i === 0} />
                <span class="picker__num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="picker__quote">{s.quote}</span>
                <span class="picker__radio" aria-hidden="true" />
              </label>

              <div class="picker__result" data-for={s.id} style={`--accent: ${s.accent}`}>
                <p class="mono picker__kicker">Where we’d start</p>
                <p class="picker__division">
                  {s.start}<span class="dot" style={`--dot: ${s.accent}`} />
                </p>
                <p class="body picker__answer">{s.answer}</p>
                <div class="picker__actions">
                  <a href={`/contact/?interest=${s.interest}`} class="btn btn--primary">
                    <span class="btn__dot" aria-hidden="true" />
                    Talk to us about this
                  </a>
                  <a href={s.link.href} class="link">
                    {s.link.label}
                    <Icon name="arrow-right" class="link__icon link__icon--right" />
                  </a>
                </div>
              </div>
            </Fragment>
          ))
        }
      </div>
    </fieldset>
  </div>
</section>

<style>
  .start__lead {
    margin-top: var(--space-m);
  }

  .picker {
    min-width: 0;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    border: 0;
  }

  .picker__grid {
    display: grid;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 62rem) {
    .picker__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-2xl);
    }

    .picker__option {
      grid-column: 1;
      grid-row: var(--row);
    }

    .picker__result {
      grid-column: 2;
      grid-row: 1 / span 5;
      align-self: start;
    }
  }

  .picker__option {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: 0.75rem;
    align-items: center;
    padding: 1.3rem 0.75rem 1.3rem 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    transition: background-color var(--dur) var(--ease-out);
  }

  .picker__option::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.5s var(--ease-out);
  }

  .picker__option:hover {
    background: rgb(255 255 255 / 0.02);
  }

  .picker__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .picker__num {
    padding-left: 0.75rem;
    color: var(--fg-3);
  }

  .picker__quote {
    font-size: var(--step-1);
    line-height: 1.38;
    color: var(--fg-2);
    transition: color var(--dur) var(--ease-out);
  }

  .picker__radio {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: border-color var(--dur) var(--ease-out);
  }

  .picker__radio::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    transform: scale(0);
    transition: transform 0.35s var(--ease-out);
  }

  .picker__option:has(:checked) {
    background: rgb(255 255 255 / 0.025);
  }

  .picker__option:has(:checked)::before {
    transform: scaleY(1);
  }

  .picker__option:has(:checked) .picker__quote {
    color: var(--fg);
  }

  .picker__option:has(:checked) .picker__radio {
    border-color: var(--accent);
  }

  .picker__option:has(:checked) .picker__radio::after {
    transform: scale(1);
  }

  .picker__option:has(:focus-visible) {
    outline: 2px solid var(--blue-bright);
    outline-offset: -2px;
  }

  .picker__result {
    display: none;
    padding: var(--space-m) 0 var(--space-l) 3.25rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 62rem) {
    .picker__result {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      margin-top: var(--space-l);
      padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
      border: 1px solid var(--line);
      border-radius: var(--radius-m);
      background:
        radial-gradient(80% 60% at 100% 0%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 70%),
        var(--bg-raise);
    }
  }

  .picker__grid:has(input[value="leadership"]:checked) .picker__result[data-for="leadership"],
  .picker__grid:has(input[value="underneath"]:checked) .picker__result[data-for="underneath"],
  .picker__grid:has(input[value="execution"]:checked) .picker__result[data-for="execution"],
  .picker__grid:has(input[value="media"]:checked) .picker__result[data-for="media"],
  .picker__grid:has(input[value="connected"]:checked) .picker__result[data-for="connected"] {
    display: block;
    animation: rise 0.6s var(--ease-out) both;
  }

  @supports not selector(:has(*)) {
    .picker__result {
      display: block;
    }
  }

  .picker__kicker {
    color: var(--fg-3);
  }

  .picker__division {
    margin-top: var(--space-s);
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .picker__answer {
    margin-top: var(--space-m);
  }

  .picker__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: var(--space-l);
  }
</style>
