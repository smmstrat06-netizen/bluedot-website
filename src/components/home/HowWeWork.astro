---
import SectionLabel from "../SectionLabel.astro";
import { getHomeData } from "../../data/home";
import { getLang } from "../../i18n";
import { ui } from "../../i18n/ui";

interface Props {
  num?: string;
  title?: string;
  /** Defaults to the home page steps and principles */
  steps?: { title: string; text: string }[];
  principles?: [string, string][];
}

const lang = getLang(Astro.url);
const t = ui[lang].labels;
const home = getHomeData(lang);

const copy = {
  en: { title: "We don’t believe in one-size-fits-all marketing.", kicker: "What you can hold us to" },
  fr: { title: "Nous ne croyons pas au marketing prêt-à-porter.", kicker: "Nos engagements" },
}[lang];

const { num = "04", title = copy.title, steps = home.steps } = Astro.props;
const principles = Astro.props.steps ? (Astro.props.principles ?? []) : home.principles;
---

<section id="how" class="section section--rule how" aria-labelledby="how-title">
  <div class="container">
    <div class="split">
      <SectionLabel num={num} text={t.how} />
      <h2 id="how-title" class="h2" data-reveal>{title}</h2>
    </div>

    <ol role="list" class="steps" data-reveal>
      {
        steps.map((s, i) => (
          <li class="step" style={`--i: ${i}`}>
            <span class="step__marker" aria-hidden="true">
              <span class="step__dot" />
            </span>
            <p class="mono step__num">
              {t.step} {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="step__title">{s.title}</h3>
            <p class="body step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    {
      principles.length > 0 && (
        <div class="principles">
          <h3 class="mono principles__kicker">{copy.kicker}</h3>
          <ul role="list" class="principles__list">
            {principles.map(([a, b], i) => (
              <li class="principle" data-reveal style={`--i: ${i}`}>
                <span class="principle__a">{a}</span> <span class="principle__b">{b}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .how {
    position: relative;
    overflow: hidden;
  }

  .how::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    pointer-events: none;
  }

  .steps {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
    padding-left: 2.25rem;
  }

  .steps::before,
  .steps::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--line-strong);
  }

  .steps::after {
    background: linear-gradient(180deg, var(--blue), var(--blue-bright));
    transform-origin: top;
    transition: transform 1.8s var(--ease-out) 0.2s;
  }

  :global(html.reveal-ready) .steps:not(.is-in)::after {
    transform: scaleY(0);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap);
      padding-left: 0;
    }

    .steps::before,
    .steps::after {
      left: 1.5rem;
      right: 1.5rem;
      top: 1.75rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .steps::after {
      background: linear-gradient(90deg, var(--blue), var(--blue-bright) 70%, transparent);
      transform-origin: left;
    }

    :global(html.reveal-ready) .steps:not(.is-in)::after {
      transform: scaleX(0);
    }
  }

  .step {
    position: relative;
  }

  /* Desktop: three open columns on a shared timeline, no cards */
  @media (min-width: 48rem) {
    .step {
      padding-right: var(--grid-gap);
    }
  }

  .step__marker {
    position: absolute;
    left: -2.25rem;
    top: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid rgba(7, 122, 231, 0.4);
    border-radius: 50%;
    background: var(--bg);
  }

  @media (min-width: 48rem) {
    .step__marker {
      position: relative;
      left: 0;
    }
  }

  .step__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    transition: transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 450ms + 400ms);
  }

  :global(html.reveal-ready) .steps:not(.is-in) .step__dot {
    transform: scale(0);
  }

  .step__num {
    color: var(--fg-3);
    font-size: 0.8125rem;
    letter-spacing: 0;
  }

  @media (min-width: 48rem) {
    .step__num {
      margin-top: var(--space-m);
    }
  }

  .step__title {
    font-family: var(--font-display);
    font-weight: 600;
    color: #ffffff;
    margin-top: 0.5rem;
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .step__text {
    margin-top: 0.85rem;
    max-width: 34ch;
    line-height: 1.6;
    color: var(--fg-2);
  }

  .principles {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--line);
  }

  .principles__kicker {
    color: var(--fg-3);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .principles__list {
    display: grid;
    gap: 1.25rem var(--grid-gap);
    margin-top: var(--space-l);
  }

  @media (min-width: 40rem) {
    .principles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 75rem) {
    .principles__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Four statements under a hairline, no boxes */
  .principle {
    font-family: var(--font-display);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .principle__a {
    display: block;
    color: #ffffff;
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.025em;
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }

  .principle__b {
    display: block;
    color: var(--fg-2);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.45;
    font-weight: 400;
  }
</style>
