---
import SectionLabel from "../SectionLabel.astro";
import { steps, principles } from "../../data/home";
---

<section id="how" class="section section--rule how" aria-labelledby="how-title">
  <div class="container">
    <div class="split">
      <SectionLabel num="04" text="How we work" />
      <h2 id="how-title" class="h2" data-reveal>We don’t believe in one-size-fits-all marketing.</h2>
    </div>

    <ol role="list" class="steps" data-reveal>
      {
        steps.map((s, i) => (
          <li class="step" style={`--i: ${i}`}>
            <span class="step__watermark" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="step__marker" aria-hidden="true">
              <span class="step__dot" />
            </span>
            <p class="mono step__num">Step {String(i + 1).padStart(2, "0")}</p>
            <h3 class="step__title">{s.title}</h3>
            <p class="body step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="principles">
      <h3 class="mono principles__kicker">What you can hold us to</h3>
      <ul role="list" class="principles__list">
        {
          principles.map(([a, b], i) => (
            <li class="principle" data-reveal style={`--i: ${i}`}>
              <span class="principle__a">{a}</span> <span class="principle__b">{b}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .how {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 700px 500px at 20% 50%, rgba(7, 122, 231, 0.05), transparent 70%),
      radial-gradient(ellipse 500px 400px at 80% 80%, rgba(234, 109, 32, 0.03), transparent 60%);
  }

  .how::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(7, 122, 231, 0.25) 20%, rgba(255, 255, 255, 0.12) 50%, rgba(234, 109, 32, 0.2) 80%, transparent);
    pointer-events: none;
  }

  .steps {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
    padding-left: 2.25rem;
  }

  .steps::before,
  .steps::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--line-strong);
  }

  .steps::after {
    background: linear-gradient(180deg, var(--blue), var(--blue-bright));
    transform-origin: top;
    transition: transform 1.8s var(--ease-out) 0.2s;
  }

  :global(html.reveal-ready) .steps:not(.is-in)::after {
    transform: scaleY(0);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap);
      padding-left: 0;
    }

    .steps::before,
    .steps::after {
      left: 1.5rem;
      right: 1.5rem;
      top: 1.75rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .steps::after {
      background: linear-gradient(90deg, var(--blue), var(--blue-bright) 70%, transparent);
      transform-origin: left;
    }

    :global(html.reveal-ready) .steps:not(.is-in)::after {
      transform: scaleX(0);
    }
  }

  .step {
    position: relative;
  }

  .step__watermark {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 1.5vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.04);
    pointer-events: none;
    user-select: none;
    transition: color 0.4s var(--ease-out);
  }

  @media (min-width: 48rem) {
    .step {
      padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem) 1.6rem 2rem;
      border-radius: var(--radius-m);
      background: linear-gradient(180deg, rgba(14, 18, 34, 0.4) 0%, rgba(9, 12, 22, 0.6) 100%);
      border: 1px solid rgba(255, 255, 255, 0.07);
      box-shadow:
        0 16px 36px -12px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transition:
        background-color 0.3s var(--ease-out),
        border-color 0.3s var(--ease-out),
        box-shadow 0.3s var(--ease-out),
        transform 0.3s var(--ease-out);
    }

    .step:hover {
      background: linear-gradient(180deg, rgba(16, 22, 42, 0.65) 0%, rgba(10, 14, 28, 0.8) 100%);
      border-color: rgba(7, 122, 231, 0.35);
      box-shadow:
        0 20px 44px -12px rgba(0, 0, 0, 0.7),
        inset 0 1px 0 rgba(255, 255, 255, 0.15),
        0 0 25px -8px rgba(7, 122, 231, 0.25);
      transform: translateY(-2px);
    }

    .step:hover .step__watermark {
      color: rgba(7, 122, 231, 0.14);
    }
  }

  .step__marker {
    position: absolute;
    left: -2.25rem;
    top: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid rgba(7, 122, 231, 0.4);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 12px rgba(7, 122, 231, 0.25);
  }

  @media (min-width: 48rem) {
    .step__marker {
      position: relative;
      left: 0;
    }
  }

  .step__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 10px var(--blue);
    transition: transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 450ms + 400ms);
  }

  :global(html.reveal-ready) .steps:not(.is-in) .step__dot {
    transform: scale(0);
  }

  .step__num {
    color: var(--fg-3);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
  }

  @media (min-width: 48rem) {
    .step__num {
      margin-top: var(--space-m);
    }
  }

  .step__title {
    font-family: var(--font-display);
    font-weight: 600;
    color: #ffffff;
    margin-top: 0.5rem;
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .step__text {
    margin-top: 0.85rem;
    max-width: 34ch;
    line-height: 1.6;
    color: var(--fg-2);
  }

  .principles {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--line);
  }

  .principles__kicker {
    color: var(--fg-3);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .principles__list {
    display: grid;
    gap: 1.25rem var(--grid-gap);
    margin-top: var(--space-l);
  }

  @media (min-width: 40rem) {
    .principles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 75rem) {
    .principles__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .principle {
    position: relative;
    overflow: hidden;
    font-family: var(--font-display);
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius-s);
    background: rgba(12, 16, 28, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .principle::before {
    content: "";
    position: absolute;
    left: 0;
    top: 15%;
    bottom: 15%;
    width: 2.5px;
    border-radius: 2px;
    background: var(--blue);
    transform: scaleY(0);
    transition: transform 0.3s var(--ease-out);
  }

  .principle:hover {
    background: rgba(16, 22, 40, 0.6);
    border-color: rgba(7, 122, 231, 0.25);
    box-shadow:
      0 14px 32px -10px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }

  .principle:hover::before {
    transform: scaleY(1);
  }

  .principle__a {
    display: block;
    color: #ffffff;
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.025em;
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }

  .principle__b {
    display: block;
    color: var(--fg-2);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.45;
    font-weight: 400;
  }
</style>
