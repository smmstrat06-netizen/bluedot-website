---
import Icon from "./Icon.astro";
---

<div class="mcta" data-mcta>
  <a href="/contact/" class="mcta__inner">
    <span class="mcta__text">
      <span class="mcta__title">Have a marketing challenge?</span>
      <span class="mcta__sub">Tell us where you are.</span>
    </span>
    <span class="mcta__btn">
      Let’s talk
      <Icon name="arrow-up-right" class="mcta__icon" />
    </span>
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-mcta]");

  if (bar) {
    // Hidden near the top of the page and whenever a conversion block is on screen
    const blockers = new Set<Element>();
    const update = () => {
      const show = window.scrollY > window.innerHeight * 0.85 && blockers.size === 0;
      bar.classList.toggle("is-shown", show);
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) blockers.add(entry.target);
        else blockers.delete(entry.target);
      }
      update();
    });

    document.querySelectorAll("[data-hide-mcta]").forEach((el) => observer.observe(el));
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>

<style>
  .mcta {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    z-index: 40;
    visibility: hidden;
    transform: translateY(calc(100% + 1.5rem));
    transition:
      transform 0.5s var(--ease-out),
      visibility 0s linear 0.5s;
  }

  .mcta.is-shown {
    visibility: visible;
    transform: none;
    transition:
      transform 0.5s var(--ease-out),
      visibility 0s;
  }

  @media (min-width: 48rem) {
    .mcta {
      display: none;
    }
  }

  .mcta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    background: rgba(8, 10, 18, 0.88);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow:
      0 20px 50px -20px rgb(0 0 0 / 0.9),
      0 0 24px -6px rgb(7 122 231 / 0.2);
  }

  .mcta__title {
    display: block;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    color: #fff;
  }

  .mcta__sub {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--fg-3);
  }

  .mcta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-radius: var(--radius-pill);
    background: var(--blue);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 0 16px rgb(7 122 231 / 0.4);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .mcta__inner:hover .mcta__btn {
    background: var(--blue-bright);
    transform: scale(1.02);
  }

  .mcta__btn :global(.mcta__icon) {
    width: 1em;
    height: 1em;
  }
</style>
