---
import SectionLabel from "./SectionLabel.astro";
import Icon from "./Icon.astro";
import type { Service } from "../data/divisions";

interface Props {
  num: string;
  title: string;
  lead: string;
  services: Service[];
  /** Shared name makes the accordion exclusive */
  group: string;
}

const { num, title, lead, services, group } = Astro.props;
---

<section id="services" class="section section--rule" aria-labelledby="services-title">
  <div class="container">
    <div class="split">
      <SectionLabel num={num} text="What we do" />
      <div>
        <h2 id="services-title" class="h2" data-reveal>{title}</h2>
        <p class="lead services__lead" data-reveal style="--i: 1">{lead}</p>
      </div>
    </div>

    <ol role="list" class="services" data-reveal>
      {
        services.map((s, i) => (
          <li class="service">
            <details class="service__details" name={group} open={i === 0}>
              <summary class="service__summary">
                <span class="service__num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="service__title">{s.title}</span>
                <span class="service__short">{s.short}</span>
                <span class="service__toggle" aria-hidden="true">
                  <Icon name="plus" />
                </span>
              </summary>
              <div class="service__body">
                <dl class="service__grid">
                  <div class="service__cell">
                    <dt class="mono">The problem</dt>
                    <dd>{s.problem}</dd>
                  </div>
                  <div class="service__cell">
                    <dt class="mono">What we do</dt>
                    <dd>{s.approach}</dd>
                  </div>
                  <div class="service__cell service__cell--result">
                    <dt class="mono">What you get</dt>
                    <dd>{s.result}</dd>
                  </div>
                </dl>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services__lead {
    margin-top: var(--space-m);
  }

  .services {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line);
  }

  .service {
    border-bottom: 1px solid var(--line);
  }

  .service__summary {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    gap: 0.35rem 1rem;
    align-items: center;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  .service__summary::-webkit-details-marker {
    display: none;
  }

  .service__num {
    align-self: start;
    padding-top: 0.75em;
    color: var(--fg-3);
  }

  .service__title {
    font-family: var(--font-display);
    font-weight: 600;
    color: #ffffff;
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.03em;
    transition: color var(--dur) var(--ease-out);
  }

  .service__summary:hover .service__title {
    color: var(--accent);
  }

  .service__short {
    grid-column: 2;
    color: var(--fg-2);
  }

  .service__toggle {
    grid-column: 3;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      transform 0.45s var(--ease-out),
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .service__toggle :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .service__summary:hover .service__toggle {
    border-color: var(--fg);
  }

  .service__details[open] .service__toggle {
    transform: rotate(45deg);
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  @media (min-width: 62rem) {
    .service__summary {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1fr) 2.75rem;
      padding-block: 1.75rem;
    }

    .service__short {
      grid-column: 3;
      grid-row: 1;
    }

    .service__toggle {
      grid-column: 4;
      grid-row: 1;
    }
  }

  .service__details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.55s var(--ease-out),
      content-visibility 0.55s allow-discrete;
  }

  .service__details[open]::details-content {
    block-size: auto;
    block-size: calc-size(auto, size);
  }

  .service__body {
    padding-bottom: var(--space-l);
  }

  @media (min-width: 62rem) {
    .service__body {
      padding-left: 4.5rem;
      padding-right: 3.75rem;
      padding-bottom: var(--space-xl);
    }
  }

  .service__grid {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 48rem) {
    .service__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap);
    }
  }

  .service__cell {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .service__cell dt {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg-3);
  }

  .service__cell dt::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .service__cell dd {
    color: var(--fg-2);
  }

  .service__cell--result {
    border-top-color: var(--accent);
  }

  .service__cell--result dt::before {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .service__cell--result dd {
    color: var(--fg);
  }
</style>
