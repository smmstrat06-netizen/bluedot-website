---
import SectionLabel from "./SectionLabel.astro";
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
import { site, mapsUrl, linkedin } from "../config/site";
import { getLang } from "../i18n";
import { ui } from "../i18n/ui";

interface Props {
  /** h1 on the dedicated contact page, h2 when embedded */
  as?: "h1" | "h2";
  num?: string;
}

const { as = "h2", num = "07" } = Astro.props;
const Heading = as;
const isPage = as === "h1";
const { contact: t, labels } = ui[getLang(Astro.url)];
---

<section
  id="contact"
  class:list={["section", "contact", { "section--rule": !isPage, "contact--page": isPage }]}
  aria-labelledby="contact-title"
  data-hide-mcta
>
  <div class="container contact__grid">
    <div class="contact__intro">
      <SectionLabel num={num} text={t.label} />
      <Heading id="contact-title" class="h1 contact__title">
        {t.title}<span class="dot"><span class="sr-only">.</span></span>
      </Heading>
      <p class="lead contact__lead">{t.lead}</p>

      <div class="contact__next">
        <p class="mono contact__kicker">{t.nextTitle}</p>
        <ol role="list" class="contact__steps">
          {
            t.next.map((step, i) => (
              <li>
                <span class="mono contact__num">{String(i + 1).padStart(2, "0")}</span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="contact__info">
        <div>
          <p class="mono contact__kicker">{t.visit}</p>
          <address class="contact__address">
            {site.address.street}<br />
            {site.address.city} {site.address.postalCode}, {t.country}
          </address>
          <a class="link" href={mapsUrl} target="_blank" rel="noopener">
            {t.maps}<span class="sr-only"> {labels.newTab}</span>
            <Icon name="arrow-up-right" class="link__icon" />
          </a>
        </div>
        {
          linkedin && (
            <div>
              <p class="mono contact__kicker">{t.follow}</p>
              <a class="link contact__social" href={linkedin} target="_blank" rel="noopener">
                {t.linkedin}<span class="sr-only"> {labels.newTab}</span>
                <Icon name="arrow-up-right" class="link__icon" />
              </a>
            </div>
          )
        }
      </div>

      {
        site.email && (
          <p class="small contact__direct">
            {t.email}{" "}
            <a class="link" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </p>
        )
      }
    </div>

    <div class="contact__panel">
      <ContactForm />
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }

  .contact::before {
    content: "";
    position: absolute;
    top: -10%;
    left: -15%;
    width: 60%;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .contact--page {
    padding-top: calc(var(--header-h) + var(--space-2xl));
  }

  .contact__grid {
    position: relative;
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 62rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    /* Only pin the intro when the whole column fits on screen */
    @media (min-height: 64rem) {
      .contact__intro {
        position: sticky;
        top: calc(var(--header-h) + 2rem);
      }
    }
  }

  .contact__title {
    margin-top: var(--space-m);
  }

  .contact__lead {
    margin-top: var(--space-m);
  }

  .contact__next {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .contact__kicker {
    color: var(--fg-3);
  }

  .contact__steps {
    display: grid;
    gap: 0.9rem;
    margin-top: var(--space-m);
  }

  .contact__steps li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.5rem;
    color: var(--fg-2);
  }

  .contact__num {
    padding-top: 0.25rem;
    color: var(--accent);
  }

  .contact__direct {
    margin-top: var(--space-l);
    color: var(--fg-2);
  }

  .contact__panel {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-m);
    background: var(--bg-raise);
  }

  .contact__info {
    display: grid;
    gap: var(--space-l) var(--grid-gap);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 36rem) {
    .contact__info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact__address {
    margin-block: var(--space-s) var(--space-2xs);
    font-style: normal;
    line-height: 1.55;
    color: var(--fg);
  }

  .contact__social {
    margin-top: var(--space-s);
  }
</style>
