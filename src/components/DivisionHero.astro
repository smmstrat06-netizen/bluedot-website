---
import CosmosCanvas from "./CosmosCanvas.astro";
import Icon from "./Icon.astro";
import type { Division } from "../data/divisions";

interface Props {
  division: Division;
  lead: string;
}

const { division: d, lead } = Astro.props;
---

<section class="dhero" style={`--accent: ${d.accent}`} aria-labelledby="page-title">
  <CosmosCanvas scene={d.scene} cx={0.72} cy={0.45} scale={0.4} />
  <div class="dhero__shade" aria-hidden="true"></div>

  <div class="container dhero__inner">
    <p class="label dhero__eyebrow">
      <span class="label__dot" aria-hidden="true"></span>
      <span class="label__num">{d.index}</span>
      <span>BlueDot {d.name} / {d.verb}</span>
    </p>

    <h1 id="page-title" class="dhero__title">
      This is where <span class="dhero__verb">we {d.verb.toLowerCase()}<span class="dot" style={`--dot: ${d.accent}`}
        ><span class="sr-only">.</span></span
      ></span>
    </h1>

    <p class="lead dhero__lead">{lead}</p>

    <div class="dhero__actions">
      <a href={`/contact/?interest=${d.id}`} class="btn btn--primary">
        <span class="btn__dot" aria-hidden="true"></span>
        {d.cta}
      </a>
      <a href="#services" class="btn btn--ghost">
        What we do
        <Icon name="arrow-down" class="btn__icon btn__icon--down" />
      </a>
    </div>
  </div>

  <div class="container">
    <ul role="list" class="dhero__caps" aria-label={`${d.name} expertise`}>
      {d.capabilities.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .dhero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(100svh, 64rem);
    padding-top: calc(var(--header-h) + var(--space-3xl));
    overflow: hidden;
  }

  .dhero :global(.cosmos) {
    z-index: -2;
  }

  .dhero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(5 7 13 / 0.88) 0%, rgb(5 7 13 / 0.45) 40%, rgb(5 7 13 / 0) 64%),
      linear-gradient(0deg, var(--bg) 0%, rgb(5 7 13 / 0) 30%);
  }

  @media (max-width: 47.99rem) {
    .dhero {
      padding-top: 40svh;
    }

    .dhero__shade {
      background: linear-gradient(0deg, var(--bg) 35%, rgb(5 7 13 / 0.65) 65%, rgb(5 7 13 / 0) 100%);
    }
  }

  .dhero__inner {
    padding-bottom: var(--space-2xl);
  }

  .dhero__eyebrow {
    animation: fade 1.2s var(--ease-out) both;
  }

  .dhero__title {
    margin-top: var(--space-m);
    max-width: 12ch;
    font-size: clamp(3rem, 1.4rem + 6.4vw, 7.75rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.05em;
    animation: rise 1.2s var(--ease-out) 0.1s both;
  }

  .dhero__verb {
    white-space: nowrap;
  }

  .dhero__lead {
    margin-top: var(--space-l);
    animation: rise 1.2s var(--ease-out) 0.35s both;
  }

  .dhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-l);
    animation: rise 1.2s var(--ease-out) 0.45s both;
  }

  .dhero__caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-2);
    animation: fade 1.4s var(--ease-out) 0.7s both;
  }

  .dhero__caps li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dhero__caps li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
