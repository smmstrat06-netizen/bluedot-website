---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import type { Division } from "../data/divisions";
import { getLang, href } from "../i18n";
import { ui } from "../i18n/ui";
import mars from "../assets/brand/mars.jpg";
import earth from "../assets/brand/earth.jpg";
import blackhole from "../assets/brand/blackhole.jpg";
import heroCosmic from "../assets/brand/hero-cosmic.jpg";

interface Props {
  division: Division;
  lead: string;
  /** Page heading; defaults to "BlueDot {name} · {division.h1}" */
  h1?: string;
  /** Large brand line; defaults to the division headline */
  display?: string;
  caps?: string[];
  image?: ImageMetadata;
}

const { division: d, lead } = Astro.props;
const lang = getLang(Astro.url);
const t = ui[lang].labels;

// Each division's planet from the brand kit
const heroImages: Record<string, ImageMetadata> = {
  consulting: mars,
  agency: earth,
  media: blackhole,
};

const heroImg = Astro.props.image ?? heroImages[d.id] ?? heroCosmic;
const h1 = Astro.props.h1 ?? `BlueDot ${d.name} · ${d.h1}`;
const caps = Astro.props.caps ?? d.capabilities;

// The last two words ("we think", "on réfléchit") stay together with the dot
const words = (Astro.props.display ?? d.headline).replace(/\.$/, "").split(" ");
const before = words.slice(0, -2).join(" ");
const verb = words.slice(-2).join(" ");
const long = before.length + verb.length > 26;
---

<section class="dhero" style={`--accent: ${d.accent}`} aria-labelledby="page-title">
  <!-- Photographic planetary background — brand kit style -->
  <div class="dhero__bg" aria-hidden="true">
    <Picture
      src={heroImg}
      alt=""
      formats={["webp"]}
      widths={[640, 960, 1376]}
      sizes="100vw"
      quality={62}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="dhero__overlay"></div>
  </div>

  <div class="container dhero__inner">
    <div class="label dhero__eyebrow">
      <span class="label__num">{d.index}</span>
      <h1 id="page-title" class="dhero__h1">{h1}</h1>
    </div>

    <p class:list={["dhero__title", { "dhero__title--long": long }]}>
      {before}{" "}<span class="dhero__verb">{verb}<span class="dot" style={`--dot: ${d.accent}`}
        ><span class="sr-only">.</span></span
      ></span>
    </p>

    <p class="lead dhero__lead">{lead}</p>

    <div class="dhero__actions">
      <a href={href("contact", lang, `?interest=${d.id}`)} class="btn btn--primary">
        {d.cta}
      </a>
      <a href="#services" class="btn btn--ghost">
        {t.whatWeDo}
        <Icon name="arrow-down" class="btn__icon btn__icon--down" />
      </a>
    </div>
  </div>

  <div class="container">
    <ul role="list" class="dhero__caps" aria-label={lang === "fr" ? `Expertises ${d.name}` : `${d.name} expertise`}>
      {caps.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .dhero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(100svh, 64rem);
    padding-top: calc(var(--header-h) + var(--space-3xl));
    overflow: hidden;
    background: #000;
  }

  /* ── Photographic background ── */
  .dhero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .dhero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    opacity: 0.78;
  }

  .dhero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgb(0 0 0 / 0.96) 0%,
        rgb(0 0 0 / 0.85) 30%,
        rgb(0 0 0 / 0.55) 52%,
        rgb(0 0 0 / 0.18) 72%,
        rgb(0 0 0 / 0) 88%
      ),
      linear-gradient(0deg,
        rgb(0 0 0 / 1) 0%,
        rgb(0 0 0 / 0.7) 12%,
        rgb(0 0 0 / 0) 28%
      );
  }

  @media (max-width: 47.99rem) {
    .dhero__bg :global(img) {
      object-position: 60% center;
      opacity: 0.38;
    }

    .dhero__overlay {
      background: linear-gradient(0deg,
        rgb(0 0 0 / 1) 0%,
        rgb(0 0 0 / 0.92) 35%,
        rgb(0 0 0 / 0.6) 65%,
        rgb(0 0 0 / 0.15) 100%
      );
    }
  }

  /* ── Content ── */
  .dhero__inner {
    padding-bottom: var(--space-2xl);
  }

  .dhero__eyebrow {
    animation: fade 1.2s var(--ease-out) both;
  }

  /* The keyword heading keeps the quiet label style */
  .dhero__h1 {
    font: inherit;
    color: inherit;
  }

  .dhero__title {
    margin-top: var(--space-m);
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.4rem + 6.4vw, 7.75rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: #fff;
    animation: rise 1.2s var(--ease-out) 0.1s both;
  }

  .dhero__verb {
    white-space: nowrap;
    color: #fff;
  }

  .dhero__lead {
    margin-top: var(--space-l);
    color: rgb(255 255 255 / 0.7);
    animation: rise 1.2s var(--ease-out) 0.35s both;
  }

  .dhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-l);
    animation: rise 1.2s var(--ease-out) 0.45s both;
  }

  .dhero__caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.9375rem;
    color: var(--fg-2);
    animation: fade 1.4s var(--ease-out) 0.7s both;
  }

  .dhero__caps li {
    color: var(--fg-2);
  }

  /* Longer brand lines (service pages) run at a smaller size */
  .dhero__title--long {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.3rem + 4.6vw, 5.75rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .dhero__title--long .dhero__verb {
    white-space: normal;
  }
</style>
