---
import Icon from "./Icon.astro";
import type { Division } from "../data/divisions";

interface Props {
  division: Division;
  lead: string;
}

const { division: d, lead } = Astro.props;

// Map each division to its cosmic hero image — brand kit style
const heroImages: Record<string, string> = {
  consulting: "/brand-assets/mars.jpg",
  agency: "/brand-assets/earth.jpg",
  media: "/brand-assets/blackhole.jpg",
};

const heroImg = heroImages[d.id] ?? "/brand-assets/hero-cosmic.jpg";
---

<section class="dhero" style={`--accent: ${d.accent}`} aria-labelledby="page-title">
  <!-- Photographic planetary background — brand kit style -->
  <div class="dhero__bg" aria-hidden="true">
    <img
      src={heroImg}
      alt=""
      class="dhero__bg-img"
      width="1400"
      height="787"
      loading="eager"
      decoding="async"
    />
    <div class="dhero__overlay"></div>
  </div>

  <!-- Division-colored atmospheric glow -->
  <div class="dhero__glow" aria-hidden="true"></div>

  <div class="container dhero__inner">
    <p class="label dhero__eyebrow">
      <span class="label__dot" aria-hidden="true"></span>
      <span class="label__num">{d.index}</span>
      <span>BlueDot {d.name} / {d.verb}</span>
    </p>

    <h1 id="page-title" class="dhero__title">
      This is where <span class="dhero__verb">we {d.verb.toLowerCase()}<span class="dot" style={`--dot: ${d.accent}`}
        ><span class="sr-only">.</span></span
      ></span>
    </h1>

    <p class="lead dhero__lead">{lead}</p>

    <div class="dhero__actions">
      <a href={`/contact/?interest=${d.id}`} class="btn btn--primary">
        <span class="btn__dot" aria-hidden="true"></span>
        {d.cta}
      </a>
      <a href="#services" class="btn btn--ghost">
        What we do
        <Icon name="arrow-down" class="btn__icon btn__icon--down" />
      </a>
    </div>
  </div>

  <div class="container">
    <ul role="list" class="dhero__caps" aria-label={`${d.name} expertise`}>
      {d.capabilities.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .dhero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(100svh, 64rem);
    padding-top: calc(var(--header-h) + var(--space-3xl));
    overflow: hidden;
    background: #000;
  }

  /* ── Photographic background ── */
  .dhero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .dhero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    opacity: 0.78;
  }

  .dhero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg,
        rgb(0 0 0 / 0.96) 0%,
        rgb(0 0 0 / 0.85) 30%,
        rgb(0 0 0 / 0.55) 52%,
        rgb(0 0 0 / 0.18) 72%,
        rgb(0 0 0 / 0) 88%
      ),
      linear-gradient(0deg,
        rgb(0 0 0 / 1) 0%,
        rgb(0 0 0 / 0.7) 12%,
        rgb(0 0 0 / 0) 28%
      );
  }

  @media (max-width: 47.99rem) {
    .dhero__bg-img {
      object-position: 60% center;
      opacity: 0.38;
    }

    .dhero__overlay {
      background: linear-gradient(0deg,
        rgb(0 0 0 / 1) 0%,
        rgb(0 0 0 / 0.92) 35%,
        rgb(0 0 0 / 0.6) 65%,
        rgb(0 0 0 / 0.15) 100%
      );
    }
  }

  /* ── Accent glow ── */
  .dhero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 50% at 75% 50%, color-mix(in oklab, var(--accent) 25%, transparent) 0%, transparent 70%);
    animation: pulse-glow 6s ease-in-out infinite;
  }

  /* ── Content ── */
  .dhero__inner {
    padding-bottom: var(--space-2xl);
  }

  .dhero__eyebrow {
    animation: fade 1.2s var(--ease-out) both;
  }

  .dhero__title {
    margin-top: var(--space-m);
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.4rem + 6.4vw, 7.75rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: #fff;
    animation: rise 1.2s var(--ease-out) 0.1s both;
  }

  .dhero__verb {
    white-space: nowrap;
    color: #fff;
  }

  .dhero__lead {
    margin-top: var(--space-l);
    color: rgb(255 255 255 / 0.7);
    animation: rise 1.2s var(--ease-out) 0.35s both;
  }

  .dhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-l);
    animation: rise 1.2s var(--ease-out) 0.45s both;
  }

  .dhero__caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
    animation: fade 1.4s var(--ease-out) 0.7s both;
  }

  .dhero__caps li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: rgb(255 255 255 / 0.65);
  }

  .dhero__caps li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
</style>
