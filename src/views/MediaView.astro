---
import BaseLayout from "../layouts/BaseLayout.astro";
import DivisionHero from "../components/DivisionHero.astro";
import Positioning from "../components/Positioning.astro";
import ServicesSection from "../components/ServicesSection.astro";
import SectionLabel from "../components/SectionLabel.astro";
import BudgetSignals from "../components/visuals/BudgetSignals.astro";
import MetricsDashboard from "../components/visuals/MetricsDashboard.astro";
import CrossLinks from "../components/CrossLinks.astro";
import CtaBand from "../components/CtaBand.astro";
import { getDivision } from "../data/divisions";
import { serviceSchema } from "../lib/schema";
import { getLang, href } from "../i18n";
import { ui } from "../i18n/ui";

const lang = getLang(Astro.url);
const d = getDivision("media", lang);

const copy = {
  en: {
    lead: "Media strategy and performance built around business impact — not vanity metrics.",
    posTitle: "Buying media is easy. Knowing where to invest is the work.",
    posText: "We plan, buy and optimize media across channels with one objective: making investment work harder.",
    fit: [
      "You’re spending on media, but can’t see its effect on the business.",
      "Channels are managed separately, each optimizing for its own numbers.",
      "You need to decide where to scale, shift or stop spend.",
    ],
    servicesTitle: "From plan to proof.",
    servicesLead: "Open a service to see the problem it solves, what we do and what you get.",
    spendTitle: "The smartest media decision is sometimes where not to spend.",
    spendLead:
      "Performance is not about exhausting the budget. It’s about knowing when to scale, where to move investment and when to stop.",
    metricsLabel: "What really matters",
    metricsTitle: "Great media metrics can hide bad business.",
    metricsLead:
      "A low cost per lead, rising click-through, falling cost per click — and no sales. We connect media metrics to real business outcomes, so the numbers that look good are also the numbers that matter.",
    crossTitle: "Media works harder with the right thinking and the right work.",
    crossText: "BlueDot Consulting sets the direction media should serve. BlueDot Agency creates the work media amplifies.",
    ctaTitle: "Make every investment work harder.",
    ctaText: "Tell us what you’re spending and what it needs to achieve.",
  },
  fr: {
    lead: "Une stratégie et une performance média pensées pour l’impact business — pas pour les indicateurs de vanité.",
    posTitle: "Acheter des médias est facile. Savoir où investir, c’est le vrai travail.",
    posText:
      "Nous planifions, achetons et optimisons les médias sur tous les canaux avec un seul objectif : faire travailler votre investissement plus dur.",
    fit: [
      "Vous investissez en médias, sans voir l’effet sur votre activité.",
      "Les canaux sont gérés séparément, chacun optimisant ses propres chiffres.",
      "Vous devez décider où augmenter, déplacer ou arrêter vos dépenses.",
    ],
    servicesTitle: "Du plan à la preuve.",
    servicesLead: "Ouvrez un service pour voir le problème qu’il résout, ce que nous faisons et ce que vous obtenez.",
    spendTitle: "La décision média la plus intelligente est parfois de savoir où ne pas dépenser.",
    spendLead:
      "La performance ne consiste pas à épuiser le budget. Il s’agit de savoir quand accélérer, où déplacer l’investissement et quand s’arrêter.",
    metricsLabel: "Ce qui compte vraiment",
    metricsTitle: "De bons chiffres médias peuvent cacher une mauvaise performance business.",
    metricsLead:
      "Un coût par lead bas, un taux de clic en hausse, un coût par clic en baisse — et aucune vente. Nous relions les indicateurs médias aux résultats business réels, pour que les chiffres qui semblent bons soient aussi ceux qui comptent.",
    crossTitle: "Les médias travaillent mieux avec la bonne réflexion et le bon travail créatif.",
    crossText: "BlueDot Consulting fixe la direction que les médias doivent servir. BlueDot Agency crée le travail que les médias amplifient.",
    ctaTitle: "Faites travailler chaque investissement plus dur.",
    ctaText: "Dites-nous ce que vous investissez et ce que cela doit accomplir.",
  },
}[lang];

const schema = serviceSchema(
  {
    name: d.h1,
    description: d.seo.description,
    path: d.href,
    serviceType: [...d.capabilities, "Google Ads", "Meta Ads", "TikTok Ads", "LinkedIn Ads"],
    trail: [{ name: `BlueDot ${d.name}`, path: d.href }],
  },
  Astro.site!,
  lang,
);
---

<BaseLayout title={d.seo.title} description={d.seo.description} image="/og/media.png" accent={d.accent} schema={schema}>
  <DivisionHero division={d} lead={copy.lead} />

  <Positioning num="01" title={copy.posTitle} text={copy.posText} fit={copy.fit} />

  <ServicesSection num="02" title={copy.servicesTitle} lead={copy.servicesLead} services={d.services} group="media-services" />

  <section class="section section--rule" aria-labelledby="spend-title">
    <div class="container">
      <div class="split">
        <SectionLabel num="03" text={ui[lang].labels.pov} />
        <div>
          <h2 id="spend-title" class="h2" data-reveal>{copy.spendTitle}</h2>
          <p class="lead page__lead" data-reveal style="--i: 1">{copy.spendLead}</p>
        </div>
      </div>
      <div class="offset page__visual">
        <BudgetSignals />
      </div>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="metrics-title">
    <div class="container">
      <div class="split">
        <SectionLabel num="04" text={copy.metricsLabel} />
        <div>
          <h2 id="metrics-title" class="h2" data-reveal>{copy.metricsTitle}</h2>
          <p class="lead page__lead" data-reveal style="--i: 1">{copy.metricsLead}</p>
        </div>
      </div>
      <div class="page__visual">
        <MetricsDashboard />
      </div>
    </div>
  </section>

  <CrossLinks num="05" current="media" title={copy.crossTitle} text={copy.crossText} />

  <CtaBand
    title={copy.ctaTitle}
    text={copy.ctaText}
    cta={d.cta}
    href={href("contact", lang, "?interest=media")}
    accent={d.accent}
  />
</BaseLayout>

<style>
  .page__lead {
    margin-top: var(--space-m);
  }

  .page__visual {
    margin-top: var(--space-2xl);
  }
</style>
