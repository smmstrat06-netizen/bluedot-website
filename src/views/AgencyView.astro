---
import BaseLayout from "../layouts/BaseLayout.astro";
import DivisionHero from "../components/DivisionHero.astro";
import Positioning from "../components/Positioning.astro";
import ServicesSection from "../components/ServicesSection.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ExecutionChain from "../components/visuals/ExecutionChain.astro";
import CrossLinks from "../components/CrossLinks.astro";
import CtaBand from "../components/CtaBand.astro";
import { getDivision } from "../data/divisions";
import { serviceSchema } from "../lib/schema";
import { getLang, href } from "../i18n";
import { ui } from "../i18n/ui";

const lang = getLang(Astro.url);
const d = getDivision("agency", lang);
const t = ui[lang].labels;

const copy = {
  en: {
    lead: "We turn strategy into things people can see, experience and act on.",
    posTitle: "Ideas matter. Execution makes them real.",
    posText:
      "BlueDot Agency brings strategy, creativity and execution together to build brand experiences that are coherent, distinctive and effective.",
    fit: [
      "Your strategy is clear and now needs to be brought to life.",
      "Your brand looks and sounds different on every channel.",
      "You need content, digital or campaigns that drive action — not just attention.",
    ],
    servicesTitle: "What we create.",
    servicesLead: "Open a service to see the problem it solves, what we do and what you get.",
    craftTitle: "Craft, with a reason behind it.",
    principles: [
      ["Strategy", "before output."],
      ["Ideas", "built to be executed."],
      ["The right talent", "for the right challenge."],
      ["One consistent brand", "across every touchpoint."],
    ],
    pov: "A great idea poorly executed is still a bad campaign.",
    povLead:
      "Ideas only count once they reach people. That’s why strategy, craft, content and execution are handled as one chain — so nothing gets lost between the brief and the result.",
    crossTitle: "Ideas with a strategy behind them — and media in front.",
    crossText:
      "BlueDot Consulting sharpens the direction before we create. BlueDot Media makes sure the work reaches the right people.",
    ctaTitle: "Have something to bring to life?",
    ctaText: "A brand, a campaign, a website or a launch — tell us what you’re making.",
  },
  fr: {
    lead: "Nous transformons la stratégie en choses que l’on peut voir, vivre et sur lesquelles on peut agir.",
    posTitle: "Les idées comptent. L’exécution les rend réelles.",
    posText:
      "BlueDot Agency réunit stratégie, créativité et exécution pour construire des expériences de marque cohérentes, distinctives et efficaces.",
    fit: [
      "Votre stratégie est claire et doit maintenant prendre vie.",
      "Votre marque ne se ressemble pas d’un canal à l’autre.",
      "Vous avez besoin de contenus, de digital ou de campagnes qui font agir — pas seulement regarder.",
    ],
    servicesTitle: "Ce que nous créons.",
    servicesLead: "Ouvrez un service pour voir le problème qu’il résout, ce que nous faisons et ce que vous obtenez.",
    craftTitle: "Du savoir-faire, avec une raison d’être.",
    principles: [
      ["La stratégie", "avant la production."],
      ["Des idées", "pensées pour être exécutées."],
      ["Les bons talents", "pour le bon défi."],
      ["Une marque cohérente", "sur tous les points de contact."],
    ],
    pov: "Une grande idée mal exécutée reste une mauvaise campagne.",
    povLead:
      "Une idée ne compte qu’une fois qu’elle atteint les gens. C’est pourquoi stratégie, savoir-faire, contenu et exécution sont traités comme une seule chaîne — pour que rien ne se perde entre le brief et le résultat.",
    crossTitle: "Des idées avec une stratégie derrière — et des médias devant.",
    crossText:
      "BlueDot Consulting affine la direction avant que nous créions. BlueDot Media s’assure que le travail atteint les bonnes personnes.",
    ctaTitle: "Quelque chose à faire exister ?",
    ctaText: "Une marque, une campagne, un site web ou un lancement — dites-nous ce que vous préparez.",
  },
}[lang];

const schema = serviceSchema(
  {
    name: d.h1,
    description: d.seo.description,
    path: d.href,
    serviceType: d.capabilities,
    trail: [{ name: `BlueDot ${d.name}`, path: d.href }],
  },
  Astro.site!,
  lang,
);
---

<BaseLayout title={d.seo.title} description={d.seo.description} image="/og/agency.png" accent={d.accent} schema={schema}>
  <DivisionHero division={d} lead={copy.lead} />

  <Positioning num="01" title={copy.posTitle} text={copy.posText} fit={copy.fit} />

  <ServicesSection num="02" title={copy.servicesTitle} lead={copy.servicesLead} services={d.services} group="agency-services" />

  <section class="section section--rule" aria-labelledby="craft-title">
    <div class="container">
      <div class="split">
        <SectionLabel num="03" text={t.how} />
        <h2 id="craft-title" class="h2" data-reveal>{copy.craftTitle}</h2>
      </div>
      <ul role="list" class="craft offset">
        {
          copy.principles.map(([a, b], i) => (
            <li class="craft__row" data-reveal style={`--i: ${i}`}>
              <span class="mono craft__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="craft__a">{a}</span>
              <span class="craft__b">{b}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="chain-title">
    <div class="container">
      <div class="split">
        <SectionLabel num="04" text={t.pov} />
        <div>
          <h2 id="chain-title" class="h2" data-reveal>{copy.pov}</h2>
          <p class="lead page__lead" data-reveal style="--i: 1">{copy.povLead}</p>
        </div>
      </div>
      <div class="offset page__visual">
        <ExecutionChain />
      </div>
    </div>
  </section>

  <CrossLinks num="05" current="agency" title={copy.crossTitle} text={copy.crossText} />

  <CtaBand
    title={copy.ctaTitle}
    text={copy.ctaText}
    cta={d.cta}
    href={href("contact", lang, "?interest=agency")}
    accent={d.accent}
  />
</BaseLayout>

<style>
  .page__lead {
    margin-top: var(--space-m);
  }

  .page__visual {
    margin-top: var(--space-2xl);
  }

  .craft {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line);
  }

  .craft__row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-bottom: 1px solid var(--line);
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .craft__num {
    color: var(--fg-3);
    letter-spacing: 0;
  }

  .craft__b {
    grid-column: 2;
    color: var(--fg-3);
  }

  @media (min-width: 48rem) {
    .craft__row {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1fr);
    }

    .craft__b {
      grid-column: 3;
    }
  }
</style>
